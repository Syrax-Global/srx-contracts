# Dependencies — restored from a lockfile, never committed
node_modules/
vendor/
venv/
.venv/
__pycache__/
*.egg-info/

# Logs — a log in a repository is a leak waiting to happen
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

