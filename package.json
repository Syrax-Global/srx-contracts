{
  "name": "srx-token",
  "version": "1.0.0",
  "private": true,
  "description": "SRX \u2014 Syrax Token omnichain ecosystem contracts",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:foundry": "forge test -vv",
    "test:foundry:invariant": "forge test --match-path \"test/foundry/invariant/*\" -vv",
    "test:foundry:ci": "FOUNDRY_PROFILE=ci forge test -vv",
    "test:all": "npm run test && npm run test:foundry",
    "fuzz:echidna": "echidna . --config echidna.yaml --contract SRXTokenEchidna",
    "slither": "slither . --config-file slither.config.json",
    "size": "hardhat size-contracts",
    "deploy:sepolia": "hardhat run scripts/deploy/01_deploy_token.js --network sepolia",
    "deploy:bsctest": "hardhat run scripts/deploy/01_deploy_token.js --network bscTestnet",
    "deploy:zksync-sepolia": "hardhat run scripts/deploy/01_deploy_token.js --network zkSyncSepolia",
    "verify:sepolia": "hardhat run scripts/verify/verify_all.js --network sepolia",
    "verify:roles": "hardhat run scripts/verify/verify_roles.js",
    "migrate:roles": "hardhat run scripts/ops/migrate_roles.js",
    "lint": "solhint 'contracts/**/*.sol'"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/hardhat-upgrades": "^3.2.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.10",
    "solhint": "^5.0.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.148",
    "@layerzerolabs/oapp-evm": "^0.4.1",
    "@layerzerolabs/oft-evm": "^4.0.1",
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5"
  }
}
